          "title": "Continuity Restored",
          "type": "boolean"
        },
        "outcome": {
          "enum": [
            "answered",
            "declined",
            "cancelled",
            "closed_unknown",
            "expired",
            "withdrawn",
            "replaced",
            "resolved"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "replacement_request_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Replacement Request Id"
        },
        "snapshot": {
          "$ref": "#/$defs/DecisionSnapshot"
        }
      },
      "required": [
        "snapshot",
        "outcome"
      ],
      "title": "TerminalPayload",
      "type": "object"
    }
  },
  "$id": "urn:decisionmesh:event-envelope:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "discriminator": {
    "mapping": {
      "execution.updated": "#/$defs/ExecutionEvent",
      "observation.recorded": "#/$defs/ObservationEvent",
      "request.corrected": "#/$defs/TerminalEvent",
      "request.opened": "#/$defs/RequestEvent",
      "request.resolved": "#/$defs/TerminalEvent",
      "request.updated": "#/$defs/RequestEvent",
      "request.withdrawn": "#/$defs/TerminalEvent",
      "source.health": "#/$defs/HealthEvent"
    },
    "propertyName": "event_kind"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/ObservationEvent"
    },
    {
      "$ref": "#/$defs/RequestEvent"
    },
    {
      "$ref": "#/$defs/TerminalEvent"
    },
    {
      "$ref": "#/$defs/ExecutionEvent"
    },
    {
      "$ref": "#/$defs/HealthEvent"
    }
  ]
}
